# Copia este archivo a .env y ajusta los valores. .env nunca se sube al repositorio.

# PostgreSQL
POSTGRES_DB=browseme
POSTGRES_USER=browseme
POSTGRES_PASSWORD=cambia-esta-contrasena

# IA local: ollama | fake | disabled
BROWSEME_AI_MODE=ollama
BROWSEME_AI_MODEL=llama3.2:3b
# En CPU un modelo de 3B tarda decenas de segundos; si se supera, el informe sale sin IA.
BROWSEME_AI_TIMEOUT=120s

# Puerto local donde se publica la web (solo en 127.0.0.1)
FRONTEND_PORT=8080

# Actívalo solo si se sirve detrás de HTTPS
BROWSEME_HSTS=false
